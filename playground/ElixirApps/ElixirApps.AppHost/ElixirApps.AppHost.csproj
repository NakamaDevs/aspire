<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>4e1198f5-3454-4f26-89a1-73bfb552cff9</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <AspireProjectOrPackageReference Include="Aspire.Hosting.AppHost" />
    <AspireProjectOrPackageReference Include="Aspire.Hosting.Elixir" />
    <AspireProjectOrPackageReference Include="Aspire.Hosting.PostgreSQL" />
    <AspireProjectOrPackageReference Include="Aspire.Hosting.Redis" />
  </ItemGroup>

</Project>
